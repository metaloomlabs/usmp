{
  "name": "USMP",
  "version": "0.4.4",
  "description": "Secure, lightweight, encrypted device communication protocol. X25519 + AES-256-GCM + HMAC-SHA256.",
  "keywords": ["iot", "security", "encryption", "esp32", "protocol"],
  "repository": {
    "type": "git",
    "url": "https://github.com/metaloomlabs/usmp"
  },
  "authors": [
    {
      "name": "winterx64",
      "url": "https://github.com/winterx64"
    }
  ],
  "license": "Apache-2.0",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "build": {
    "srcDir": "src",
    "flags": ["-std=gnu++17"]
  },
  "examples": [
    {
      "name": "basic",
      "base": "examples/basic",
      "files": ["basic.ino"]
    },
    {
      "name": "callbacks",
      "base": "examples/callbacks",
      "files": ["callbacks.ino"]
    }
  ]
}